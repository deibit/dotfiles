# ~/.zshenv

export PATH="$HOME/.local/bin:$PATH"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Set up neovim as the default editor.
export EDITOR="nvim"
if [[ -r "$XDG_CONFIG_HOME/dotfiles/profile" ]] &&
    [[ "$(<"$XDG_CONFIG_HOME/dotfiles/profile")" == slim ]]; then
    export EDITOR="vslim"
    # nvim, incluso fuera de un shell interactivo, usa los datos aislados de slim.
    export NVIM_APPNAME="nvim-slim"
elif [[ ${NVIM_APPNAME:-} == nvim-slim ]]; then
    unset NVIM_APPNAME
fi
export VISUAL="$EDITOR"

# GOPATH y GOBIN
export GOPATH="$HOME/go"
export GOBIN="$HOME/go/bin"
export PATH="$GOBIN:$PATH"

# Cargo
export PATH="$HOME/.cargo/bin:$PATH"

# Disable Apple's save/restore mechanism.
export SHELL_SESSIONS_DISABLE=1

# uv
# Work only with managed Pythons (do not allow system pythons)
export UV_MANAGED_PYTHON=1
